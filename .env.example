# Required for the browser agent
OPENAI_API_KEY=

# Enable LangSmith traces for the LangGraph agent and its model/tool steps.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rusk

# Set this only for a non-US LangSmith deployment.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Next.js API routes may exit immediately after a completed run; submit traces
# before returning the response so the final tool call is retained.
LANGCHAIN_CALLBACKS_BACKGROUND=false
